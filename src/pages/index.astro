---
import Layout from '~/layouts/PageLayout.astro';
import { getCollection } from 'astro:content';
import { cleanSlug, getPermalink } from '~/utils/permalinks';

import EditorsPicks from '~/components/widgets/EditorsPicks.astro';

import magazineCover from '~/assets/images/magazine-cover.webp';
import featuredSpot from '~/assets/images/art-evolves.webp';
import fashionEditorial from '~/assets/images/fashion-ai-articles.webp';
import cultureEditorial from '~/assets/images/culture-ai-articles.webp';
import fashionImage from '~/assets/images/fashion.webp';
import cultureImage from '~/assets/images/culture.webp';
import newsImage from '~/assets/images/news.webp';
import musicImage from '~/assets/images/music.webp';
import architectureImage from '~/assets/images/architecture.webp';
import artImage from '~/assets/images/art.webp';
import artistPrintsImage from '~/assets/images/artofthediligent-prints.webp';
import butterflyBgImage from '~/assets/images/butterflybg.webp';

import artofthediligent from '~/assets/images/artofthediligent.webp';
import derekImage from '~/assets/images/derek.webp';
import voltageImage from '~/assets/images/voltage.webp';
import jairoImage from '~/assets/images/jairo.webp';

import shopJournalsImage from '~/assets/images/journals.webp';
import shopBooksImage from '~/assets/images/books.webp';
import shopApparelImage from '~/assets/images/apparel.webp';
import shopPosterImage from '~/assets/images/posters.webp';
import shopAccessoriesImage from '~/assets/images/accessories.webp';
import shopMousepadsImage from '~/assets/images/mousepads.webp';

import CardGrid from '~/components/ui/cardGrid.astro';
import ProductGrid from '~/components/ui/productGrid.astro';
import CardGrid2 from '~/components/ui/cardGrid2.astro';
import ShopCollections from '~/components/ui/ShopCollections.astro';
import FeaturedProducts from '~/components/shop/FeaturedProducts.astro';
import HeroVideo from '~/components/widgets/Hero4-video.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import Content2 from '~/components/widgets/Content2.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';

import Button from '~/components/ui/Button.astro';
import Image from '~/components/common/Image.astro';

const appStoreImg = '~/assets/images/app-store.png';
const appStoreDownloadLink = 'https://github.com/onwidget/astrowind';

const googlePlayImg = '~/assets/images/google-play.png';
const googlePlayDownloadLink = 'https://github.com/onwidget/astrowind';

const articles = await getCollection('articles');
const products = await getCollection('products');

const featuredMagazine = articles.find(
  (article) => article.data.category === 'Magazine Issues' && article.data.featured
);
const editorsPicks = articles.filter((article) => article.data.featured).slice(0, 3);
const featuredArtists = articles.filter((article) => article.data.category === 'Featured Artists').slice(0, 3);
const shopCollections = [...new Set(products.map((product) => product.data.collection))];
const mostRead = articles.sort((a, b) => {
  const dateA = a.data.date ? new Date(a.data.date).getTime() : 0;
  const dateB = b.data.date ? new Date(b.data.date).getTime() : 0;
  return dateB - dateA;
}).slice(0, 3);

// Featured artists roster for homepage rotation (beta)
const artistRoster = [
  {
    name: 'The Diligent',
    handle: 'Art of the Diligent',
    bio: 'Paintings, digital art, and AI-based work. Founder of Art Evolves.',
    image: artofthediligent.src,
    url: '/',
  },
  {
    name: 'Thamer Ossra',
    handle: '@PanoramaJasmin',
    bio: 'Creative Director and AI artist. Style-blending across semi-anime, dark fantasy, and cosmic work.',
    image: featuredSpot.src,
    url: 'https://x.com/PanoramaJasmin',
  },
  {
    name: 'The Shadow Governor',
    handle: '@shadow_governor',
    bio: 'Observations series under SYSTEM. Monumental conceptual and dark surreal work.',
    image: artImage.src,
    url: 'https://x.com/shadow_governor',
  },
  {
    name: 'Julian C',
    handle: '@Julianc_AI',
    bio: 'Character work and vibrant cultural portraits. Multi-tool pipeline with Midjourney and ComfyUI.',
    image: cultureImage.src,
    url: 'https://x.com/Julianc_AI',
  },
];

const metadata = {
  title: 'Art Evolves — Art, Culture, Music & Fashion at the Edge of AI',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <header class="py-0">
    <div
      class="w-full h-[600px] bg-center bg-cover bg-no-repeat"
      style='background-image: url("https://main.d3cz6hzvf33iri.amplifyapp.com/wp-content/uploads/2024/05/new-moon-goddess-mucha-art-of-the-diligent.jpg");'
    >
      <div class="flex items-center justify-center w-full h-full bg-gray-900 bg-opacity-50 py-28">
        <div class="text-center">
          <div class="container px-4 mx-auto">
            <div class="max-w-4xl mx-auto text-center">
              <span class="text-gray-200 font-semibold uppercase st">ART EVOLVES</span>
              <h2 class="mt-8 mb-6 text-5xl lg:text-7xl font-bold font-heading text-gray-100">
                Art, Culture, Music & Fashion at the Edge of AI
              </h2>
              <p class="max-w-3xl mx-auto mb-10 text-lg text-gray-300">
                Curated features, artist profiles, and cultural observation from the post-AI world. Featuring painters, digital artists, and generative creators.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- Featured Artists Rotation (beta) -->
  <section class="py-12 px-4">
    <div class="text-center mb-10">
      <h2 class="font-black dark:text-white text-4xl lg:text-5xl mb-4 font-heading uppercase">Featured Artists</h2>
      <p class="text-lg text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
        A rotating roster of artists working across traditional, digital, and AI practices. Interviews and deeper features coming soon.
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 max-w-7xl mx-auto">
      {artistRoster.map((artist) => (
        <a href={artist.url} class="block group" target="_blank" rel="noopener">
          <img src={artist.image} alt={artist.name} class="w-full h-48 object-cover rounded-lg mb-4" />
          <h3 class="text-xl font-semibold">{artist.name}</h3>
          <p class="text-sm text-gray-500">{artist.handle}</p>
          <p class="text-gray-600 dark:text-gray-400 mt-2">{artist.bio}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- Shop Collections Widget ************** -->
  <div class="my-4">
    <div class="text-center pt-10 mb-0">
      <h2 class="font-black dark:text-white text-5xl lg:text-5xl mb-4 font-heading uppercase">Prints & Editions</h2>
      <p class="text-lg text-gray-600 dark:text-gray-400">
        Work from The Diligent and featured artists, available as prints and editions.
      </p>
    </div>

    <ShopCollections
      collections={[
        {
          title: 'Apparel',
          url: '/shop/apparel',
          image: 'https://art-evolves-content-drop.s3.us-east-1.amazonaws.com/products/apparel/apparel-category.webp',
          alt: 'Apparel collection',
        },
        {
          title: 'Posters',
          url: '/shop/posters',
          image: 'https://art-evolves-content-drop.s3.us-east-1.amazonaws.com/products/posters/poster-category.webp',
          alt: 'Posters collection',
        },
        {
          title: 'Journals',
          url: '/shop/journals',
          image: 'https://art-evolves-content-drop.s3.us-east-1.amazonaws.com/products/journals/journals-category.webp',
          alt: 'Journals collection',
        },
        {
          title: 'Books',
          url: '/shop/books',
          image: 'https://art-evolves-content-drop.s3.us-east-1.amazonaws.com/products/books/books-category.webp',
          alt: 'Books collection',
        },
        {
          title: 'Mousepads',
          url: '/shop/mousepads',
          image: shopMousepadsImage,
          alt: 'Mousepads collection',
        },
        {
          title: 'Mugs',
          url: '/shop/mugs',
          image: shopAccessoriesImage,
          alt: 'Mugs collection',
        },
      ]}
    />
  </div>

  <!-- Featured Artwork ************** -->
  <FeaturedProducts 
    limit={4}
    columns={4}
    title="Featured Artwork"
    subtitle="Selected pieces from The Diligent and the Art Evolves roster."
  />

  <section class="py-12">
    <div
      class="w-full h-[600px] bg-center bg-cover bg-no-repeat"
      style='background-image: url("https://s3.us-east-1.amazonaws.com/artofthediligent.com/testArt/diligentmarketingsolutions_A_tarot_card_portrait_of_Teyonah_Par_8e49e883-d330-419f-ae4c-5b4282f3a631.webp");'
    >
      <div class="flex items-center justify-center w-full h-full bg-gray-900 bg-opacity-50 py-28">
        <div class="text-center">
          <div class="container px-4 mx-auto">
            <div class="max-w-4xl mx-auto text-center">
             <span class="text-gray-200 font-semibold uppercase st">CULTURE</span>
              <h2 class="mt-8 mb-6 text-5xl lg:text-7xl font-bold font-heading text-gray-100">
                Notes from the Edge
              </h2>
              <p class="max-w-3xl mx-auto mb-10 text-lg text-gray-300">
                Observations on AI, authorship, process, and the cultural lines creators are navigating.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Newsletter Signup -->
  <section class="py-16 text-center bg-primary text-white">
    <h2 class="text-3xl font-bold mb-4">Stay Informed</h2>
    <p class="text-lg mb-8">Get exclusive AI art insights, artist features, and updates from Art Evolves.</p>
    <form class="flex justify-center gap-4">
      <input type="email" placeholder="Enter your email" class="p-2 rounded text-black w-64" />
      <button type="submit" class="bg-black text-primary-500 px-6 py-2 rounded hover:bg-gray-200">Subscribe</button>
    </form>
  </section>
</Layout>
